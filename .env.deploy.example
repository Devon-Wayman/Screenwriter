# Copy this file to .env.deploy.local and fill in values for your NAS.
# .env.deploy.local is ignored by Git. Do not put passwords in this file.

NAS_HOST=parents-nas
NAS_USER=your-nas-user
NAS_SSH_PORT=22

# This directory must already be writable by NAS_USER.
REMOTE_SOURCE_DIR=/home/your-nas-user/screenwriter-web

# Find the installed app directory with:
# sudo find /var/lib/casaos/apps -maxdepth 2 -name docker-compose.yml
REMOTE_COMPOSE_FILE=/var/lib/casaos/apps/screenwriter/docker-compose.yml

# These must match the installed CasaOS Compose definition.
REMOTE_SERVICE_NAME=screenwriter
IMAGE_NAME=screenwriter-web:0.1.0
APP_PORT=3420

# Set to 1 when Docker and the CasaOS Compose file require sudo.
NAS_USE_SUDO=1
